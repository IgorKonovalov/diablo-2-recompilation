# plan 0031 Phase 2, first step (run:2026-10-15-vendors): load a built vendor save, show the inventory and the
# character sheet (gold), then Save and Exit so the game writes the save back (compared with the built file).
# Main menu -> Single Player -> OK on the only character -> Select Difficulty: NORMAL. 800x600, window-relative.
click 700 150   # empty background: the first click only activates the window
sleep 1
click 400 307   # SINGLE PLAYER
sleep 3
click 690 556   # OK on the character-select screen (first character is preselected)
sleep 2
click 400 280   # NORMAL in the Select Difficulty box
sleep 14
shot workspace/logs/vendor-load-ingame.png
key i           # inventory (gold)
sleep 1
shot workspace/logs/vendor-load-inv.png
key i
sleep 1
key c           # character sheet (level, experience)
sleep 1
shot workspace/logs/vendor-load-char.png
key c
sleep 1
key Escape      # game menu
sleep 1
click 400 262   # SAVE AND EXIT GAME
sleep 6
shot workspace/logs/vendor-load-menu.png
