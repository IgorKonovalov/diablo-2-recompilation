# plan 0029 Phase 0 (run:2026-10-15-socket-saves): load a built socketed save, show the inventory, then
# Save and Exit so the game writes the save back (the written file is compared with the built one).
# Main menu -> Single Player -> OK on the only character -> Select Difficulty: NORMAL. 800x600, window-relative.
click 700 150   # empty background: the first click only activates the window
sleep 1
click 400 307   # SINGLE PLAYER
sleep 3
click 690 556   # OK on the character-select screen (first character is preselected)
sleep 2
click 400 280   # NORMAL in the Select Difficulty box
sleep 14
shot workspace/logs/socket-load-nova-ingame.png
key i           # inventory
sleep 1
shot workspace/logs/socket-load-nova-inv.png
key i
sleep 1
key Escape      # game menu
sleep 1
click 400 262   # SAVE AND EXIT GAME
sleep 6
shot workspace/logs/socket-load-nova-menu.png
