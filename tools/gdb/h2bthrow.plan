# tools/d2pilot.py cube --plan for tools/d2s_recipes/h2bthrow.json (plan 0038 batch H2b, run:2026-10-20-sweep-items-chain)
# classic game: row 62 (1 perfect skull + 1 rare item + The Stone of Jordan -> a rare of the same type, ilvl 66)
# on nine built rare throwing weapons (tkf, tax); each output goes back to its input's cells
key:i
rclick:inv:8,2,2,2
sleep:1
shot:workspace/logs/h2b/h2bthrow-open.png
