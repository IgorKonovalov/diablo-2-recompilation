tm
out:inv:0,3,1,1
# step 3: row 60 magic reroll
mv:inv:1,2,1,1>cube:0,0,1,1
mv:inv:1,3,1,1>cube:0,1,1,1
mv:inv:2,0,1,1>cube:0,2,1,1
mv:inv:2,1,1,1>cube:0,3,1,1
tm
